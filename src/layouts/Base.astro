---
// Base.astro — shell de SEO + design da casa para schematize.org.
// O quê: <head> completo (title/description, self-canonical, hreflang recíproco dos 6
// locales + x-default, OG/Twitter, JSON-LD Organization+WebSite com sameAs cross-domain)
// e o design system (tokens, dark/light, sem emoji). Onde: envolve todas as páginas.
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { alternates, LOCALE_META, DEFAULT_LOCALE, isRtl, t, path, type Locale } from "../lib/i18n";

interface Props {
  locale: Locale;
  slug?: string;
  title: string;
  description: string;
  jsonld?: unknown[];
  /** Rótulo do último nó do breadcrumb (usa nav.<slug> por padrão). */
  crumb?: string;
}
const { locale, slug = "", title, description, jsonld = [], crumb } = Astro.props;
const site = Astro.site ?? new URL("https://schematize.org");
const canonical = new URL(`/${locale}/${slug ? slug + "/" : ""}`, site).href;
const alts = alternates(slug);
const ogLocale = LOCALE_META[locale].bcp47.replace("-", "_");
const dir = isRtl(locale) ? "rtl" : "ltr";
const origin = site.origin;
const pageBcp47 = LOCALE_META[locale].bcp47;

const org = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${origin}/#org`,
  name: "schematize",
  legalName: "Schematize Ltda - EPP",
  url: origin,
  logo: `${origin}/favicon.svg`,
  foundingDate: "2024-02-16",
  description:
    "schematize.org is the open-source and technology-research lab behind schematize — building tools in the open and sharing what we learn.",
  address: {
    "@type": "PostalAddress",
    addressLocality: "São Paulo",
    addressRegion: "SP",
    addressCountry: "BR",
  },
  contactPoint: [
    {
      "@type": "ContactPoint",
      contactType: "administrative",
      email: "contabil@schematize.me",
      areaServed: "BR",
    },
  ],
  sameAs: ["https://github.com/schematizeme"],
};
const website = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${origin}/#website`,
  name: "schematize.org",
  url: origin,
  inLanguage: pageBcp47,
  publisher: { "@id": `${origin}/#org` },
};

// Nó específico da página + breadcrumb (só em páginas internas; a home é coberta
// por Organization+WebSite). Tipo por slug — sem inventar dado (research/projects
// são páginas de coleção institucional). Nome do breadcrumb vem do nav i18n.
const PAGE_TYPES: Record<string, string> = {
  research: "CollectionPage",
  projects: "CollectionPage",
  about: "AboutPage",
  contact: "ContactPage",
  legal: "CollectionPage",
  sitemap: "WebPage",
};
const crumbName = crumb ?? t(locale, `nav.${slug}`);
const pageGraphs = [];
if (slug) {
  pageGraphs.push({
    "@context": "https://schema.org",
    "@type": PAGE_TYPES[slug] ?? "WebPage",
    "@id": `${canonical}#webpage`,
    url: canonical,
    name: title,
    description,
    inLanguage: pageBcp47,
    isPartOf: { "@id": `${origin}/#website` },
    breadcrumb: { "@id": `${canonical}#breadcrumb` },
  });
  pageGraphs.push({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": `${canonical}#breadcrumb`,
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "schematize", item: new URL(`/${locale}/`, site).href },
      { "@type": "ListItem", position: 2, name: crumbName, item: canonical },
    ],
  });
}
const graphs = [org, website, ...pageGraphs, ...jsonld];
---

<!doctype html>
<html lang={LOCALE_META[locale].bcp47} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script src="/js/sz-lang.js" is:inline></script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alts.map((a) => (
      <link rel="alternate" hreflang={a.bcp47} href={new URL(a.href, site).href} />
    ))}
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(`/${DEFAULT_LOCALE}/${slug ? slug + "/" : ""}`, site).href}
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="schematize" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@500;600;700&family=Inter:wght@400;450;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    {graphs.map((g) => (
      <script type="application/ld+json" set:html={JSON.stringify(g)} />
    ))}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header locale={locale} slug={slug} />
    {slug && (
      <nav class="crumbs wrap" aria-label="Breadcrumb">
        <a class="crumb-home" href={path(locale, "")}>schematize<span aria-hidden="true">.org</span></a>
        <span class="crumb-sep" aria-hidden="true">/</span>
        <span class="crumb-current" aria-current="page">{crumbName}</span>
      </nav>
    )}
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />

    <style is:global>
      :root {
        --bg: #ffffff;
        --surface: #fafafc;
        --card: #ffffff;
        --ink: #08090c;
        --ink-2: #1d2127;
        --muted: #6a7280;
        --faint: #9aa1ac;
        --line: #ececf0;
        --line-2: #f3f3f6;
        --accent: #2f54ff;
        --accent-ink: #2444d8;
        --accent-wash: rgba(47, 84, 255, 0.07);
        --ok: #1f7d5c;
        --radius: 18px;
        --radius-lg: 24px;
        --maxw: 1080px;
        --shadow-sm: 0 1px 2px rgba(10, 12, 20, 0.04), 0 2px 8px rgba(10, 12, 20, 0.04);
        --shadow-md: 0 2px 6px rgba(10, 12, 20, 0.05), 0 12px 32px rgba(10, 12, 20, 0.07);
        --step-1: clamp(0.8rem, 0.78rem + 0.1vw, 0.86rem);
        --step0: clamp(1rem, 0.97rem + 0.16vw, 1.06rem);
        --step1: clamp(1.15rem, 1.06rem + 0.42vw, 1.34rem);
        --step2: clamp(1.5rem, 1.3rem + 0.95vw, 2rem);
        --step3: clamp(2rem, 1.55rem + 2.1vw, 3rem);
        --step4: clamp(2.7rem, 1.9rem + 3.7vw, 4.6rem);
        --font-sans: "Inter", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        --font-disp: "Inter Tight", "Inter", system-ui, -apple-system, sans-serif;
        --font-mono: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #060708;
          --surface: #0c0e11;
          --card: #101318;
          --ink: #f4f6f9;
          --ink-2: #d3d8e0;
          --muted: #99a1ad;
          --faint: #6b7280;
          --line: #1c2028;
          --line-2: #14171d;
          --accent: #6f8bff;
          --accent-ink: #93a8ff;
          --accent-wash: rgba(111, 139, 255, 0.1);
          --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.4);
          --shadow-md: 0 2px 8px rgba(0, 0, 0, 0.4), 0 16px 40px rgba(0, 0, 0, 0.5);
        }
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font-family: var(--font-sans);
        font-size: var(--step0);
        line-height: 1.62;
        letter-spacing: -0.006em;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }
      .skip {
        position: absolute; left: -999px; top: 0; background: var(--ink); color: var(--bg);
        padding: 0.6rem 1rem; z-index: 100; border-radius: 0 0 8px 0;
      }
      .skip:focus { left: 0; }
      a { color: var(--accent-ink); text-decoration: none; }
      a:hover { text-decoration: underline; text-underline-offset: 3px; }
      h1, h2, h3 { font-family: var(--font-disp); line-height: 1.05; letter-spacing: -0.03em; margin: 0 0 0.5em; }
      h1 { font-size: var(--step4); font-weight: 600; }
      h2 { font-size: var(--step3); font-weight: 600; }
      h3 { font-size: var(--step1); font-weight: 600; letter-spacing: -0.02em; line-height: 1.2; }
      p { margin: 0 0 1rem; max-width: 66ch; }
      main { display: block; }
      code, kbd { font-family: var(--font-mono); font-size: 0.9em; }
      .wrap { width: 100%; max-width: var(--maxw); margin-inline: auto; padding-inline: clamp(1.15rem, 4vw, 2rem); }
      .wrap-tight { max-width: 860px; }
      section { padding-block: clamp(3.5rem, 8vw, 7.5rem); }
      .kicker {
        font-family: var(--font-mono); font-size: var(--step-1); letter-spacing: 0.02em;
        color: var(--accent-ink); margin: 0 0 1.1rem; font-weight: 500;
        display: inline-flex; align-items: center; gap: 0.55rem;
      }
      .kicker::before {
        content: ""; width: 1.4rem; height: 1px; background: currentColor; opacity: 0.55;
      }
      .lede { font-size: var(--step1); color: var(--muted); max-width: 58ch; line-height: 1.5; letter-spacing: -0.01em; }
      .btn {
        display: inline-flex; align-items: center; gap: 0.45rem; font-weight: 550;
        padding: 0.7rem 1.35rem; border-radius: 980px; border: 1px solid transparent;
        font-family: var(--font-sans); font-size: var(--step0); cursor: pointer;
        transition: transform 0.18s ease, background 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
        letter-spacing: -0.01em;
      }
      .btn:hover { text-decoration: none; }
      .btn-primary { background: var(--accent); color: #fff; }
      .btn-primary:hover { background: var(--accent-ink); transform: translateY(-1px); box-shadow: var(--shadow-sm); }
      .btn-ghost { border-color: var(--line); color: var(--ink); background: transparent; }
      .btn-ghost:hover { border-color: var(--faint); background: var(--surface); }
      .btn-plain { color: var(--accent-ink); background: transparent; padding-inline: 0.2rem; }
      .btn-plain::after { content: "\2192"; transition: transform 0.18s ease; }
      .btn-plain:hover::after { transform: translateX(3px); }
      .grid { display: grid; gap: clamp(0.9rem, 2vw, 1.4rem); }
      .cols-2 { grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr)); }
      .cols-3 { grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr)); }
      .card {
        background: var(--card); border: 1px solid var(--line); border-radius: var(--radius);
        padding: clamp(1.3rem, 2.6vw, 1.9rem);
        transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
      }
      .card h3 { margin-top: 0; }
      a.card:hover { text-decoration: none; transform: translateY(-3px); box-shadow: var(--shadow-md); border-color: transparent; }
      /* Ícone de card (Lucide/Simple Icons via astro-icon) — pastilha de marca. */
      .card-ico {
        display: inline-flex; align-items: center; justify-content: center;
        width: 42px; height: 42px; margin-bottom: 1rem; border-radius: 12px;
        background: var(--accent-wash); color: var(--accent-ink);
      }
      .card-ico [data-icon] { width: 22px; height: 22px; }
      .card:hover .card-ico { color: var(--accent); }
      .muted { color: var(--muted); }
      /* Breadcrumb: faixa própria abaixo do header (não dentro do nav). */
      .crumbs {
        display: flex; flex-wrap: wrap; align-items: center; gap: 0.2rem 0.55rem;
        padding-block: 0.9rem 0; font-size: var(--step-1); color: var(--faint);
      }
      .crumbs a { color: var(--muted); }
      .crumbs a:hover { color: var(--ink); text-decoration: none; }
      .crumb-home { font-family: var(--font-disp); font-weight: 600; letter-spacing: -0.02em; }
      .crumb-home span { color: var(--faint); }
      .crumb-sep { color: var(--faint); opacity: 0.55; }
      .crumb-current { color: var(--ink-2); }
      .surface { background: var(--surface); }
      .hair { border-top: 1px solid var(--line); }
      .eyebrow-row { display: flex; flex-wrap: wrap; gap: 0.5rem; }
      .tag {
        font-family: var(--font-mono); font-size: var(--step-1); color: var(--muted);
        border: 1px solid var(--line); border-radius: 999px; padding: 0.24rem 0.75rem; background: var(--card);
      }
      pre {
        background: #0b0d12; color: #e8ecf4; border-radius: var(--radius); padding: 1.15rem 1.3rem;
        overflow-x: auto; font-family: var(--font-mono); font-size: 0.86rem; line-height: 1.75;
        border: 1px solid rgba(255, 255, 255, 0.06); box-shadow: var(--shadow-md);
      }
      .cta-row { display: flex; flex-wrap: wrap; gap: 0.7rem; margin-top: 1.8rem; align-items: center; }
      hr { border: 0; border-top: 1px solid var(--line); margin: 0; }
      .eyebrow-lift { opacity: 0; transform: translateY(12px); transition: opacity 0.6s ease, transform 0.6s ease; }
      .in { opacity: 1; transform: none; }
      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        * { transition: none !important; animation: none !important; }
        .eyebrow-lift { opacity: 1; transform: none; }
      }
      /* RTL (ar, fa): o layout já usa propriedades lógicas (margin/padding-inline),
         então só precisamos espelhar as setas decorativas e ancorar o skip-link. */
      [dir="rtl"] .btn-plain::after,
      [dir="rtl"] .plat .more::after { display: inline-block; transform: scaleX(-1); }
      [dir="rtl"] .btn-plain:hover::after { transform: scaleX(-1) translateX(3px); }
      [dir="rtl"] .plat:hover .more::after { transform: scaleX(-1) translateX(3px); }
      [dir="rtl"] .skip { left: auto; right: -999px; border-radius: 0 0 0 8px; }
      [dir="rtl"] .skip:focus { left: auto; right: 0; }
    </style>
    <script>
      // Reveal-on-scroll leve (fina, sem libs) — só desloca elementos marcados .eyebrow-lift.
      const io = new IntersectionObserver(
        (es) => es.forEach((e) => e.isIntersecting && (e.target.classList.add("in"), io.unobserve(e.target))),
        { rootMargin: "0px 0px -8% 0px", threshold: 0.06 }
      );
      const arm = () => document.querySelectorAll(".eyebrow-lift").forEach((el) => io.observe(el));
      document.addEventListener("DOMContentLoaded", arm);
      arm();
    </script>
  </body>
</html>
