---
import Base from "../../layouts/Base.astro";
import { LOCALES, t, tx, path, type Locale } from "../../lib/i18n";
export function getStaticPaths() {
  return LOCALES.map((l) => ({ params: { lang: l } }));
}
const lang = Astro.params.lang as Locale;
const items = tx<{ h: string; p: string; href: string; label: string }[]>(lang, "contact.channels.items");

// ContactPage — o ContactPoint detalhado vive no Organization (Base), referenciado por @id.
const contactJsonld = [
  {
    "@context": "https://schema.org",
    "@type": "ContactPage",
    name: t(lang, "contact.meta.title"),
    about: { "@id": "https://schematize.org/#org" },
  },
];
---
<Base
  locale={lang}
  slug="contact"
  crumb={t(lang, "nav.contact")}
  title={t(lang, "contact.meta.title")}
  description={t(lang, "contact.meta.desc")}
  jsonld={contactJsonld}
>
  <section class="hero">
    <div class="wrap wrap-tight">
      <p class="kicker">{t(lang, "contact.hero.kicker")}</p>
      <h1>{t(lang, "contact.hero.h1")}</h1>
      <p class="lede">{t(lang, "contact.hero.sub")}</p>
    </div>
  </section>

  <section class="surface hair">
    <div class="wrap">
      <h2>{t(lang, "contact.channels.title")}</h2>
      <div class="grid cols-3" style="margin-top:1.8rem">
        {items.map((c) => (
          <a class="card" href={c.href}>
            <h3>{c.h}</h3>
            <p class="muted">{c.p}</p>
            <span class="chan">{c.label}</span>
          </a>
        ))}
      </div>
      <p class="muted note">
        {t(lang, "contact.note")} <a href={path(lang, "legal/privacy")}>{t(lang, "legal.docs.privacy.h1")}</a>.
      </p>
    </div>
  </section>
</Base>

<style>
  .hero { padding-block: clamp(3rem, 8vw, 6rem); }
  .chan { display: inline-block; margin-top: 0.9rem; font-family: var(--font-mono); font-size: var(--step-1); color: var(--accent-ink); }
  .note { margin-top: 1.8rem; font-size: var(--step-1); max-width: 66ch; }
</style>
