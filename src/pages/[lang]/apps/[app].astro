---
import Base from "../../../layouts/Base.astro";
import Cmd from "../../../components/Cmd.astro";
import { Icon } from "astro-icon/components";
import { LOCALES, t, tx, path, type Locale } from "../../../lib/i18n";
import {
  APPS, REPO, RELEASES, WIN_REPO, WIN_RELEASES, INSTALL_WIN, GIT_WIN, cmds,
} from "../../../lib/apps";

export function getStaticPaths() {
  return LOCALES.flatMap((l) => APPS.map((a) => ({ params: { lang: l, app: a.slug } })));
}
const lang = Astro.params.lang as Locale;
const app = APPS.find((a) => a.slug === Astro.params.app)!;
const idx = APPS.indexOf(app);
const item = tx<{ h: string; p: string }[]>(lang, "apps.items")[idx];
const feats = tx<string[]>(lang, `apps.detail.${app.slug}`);
const c = cmds(app);
const copy = t(lang, "apps.ui.copy");
const title = `${item.h} — ${t(lang, "apps.ui.kicker")} — schematize.org`;
---
<Base locale={lang} slug={`apps/${app.slug}`} crumb={item.h} title={title} description={item.p}>
  <section class="hero">
    <div class="wrap">
      <p class="back"><a href={path(lang, "apps")}><Icon name="lucide:arrow-left" aria-hidden="true" />{t(lang, "apps.ui.back")}</a></p>
      <p class="kicker">{t(lang, "apps.ui.kicker")}</p>
      <h1><span class="ico" aria-hidden="true"><Icon name={`lucide:${app.icon}`} /></span>{item.h}</h1>
      <p class="lede">{item.p}</p>
    </div>
  </section>

  <section class="surface hair">
    <div class="wrap">
      <h2>{t(lang, "apps.ui.whatItDoes")}</h2>
      <ul class="feats" role="list">
        {feats.map((f) => (
          <li><Icon name="lucide:check" aria-hidden="true" /><span>{f}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <section>
    <div class="wrap">
      <h2>{t(lang, "apps.ui.install")}</h2>
      {c.inKit && <p class="muted lead-note">{t(lang, "apps.ui.inKit")}</p>}
      {app.flag === "" && <p class="muted lead-note">{t(lang, "apps.ui.baseNote")}</p>}

      <p class="step-label"><Icon name="simple-icons:linux" aria-hidden="true" />Linux</p>
      <Cmd cmd={c.linux} copy={copy} />
      <p class="step-label"><Icon name="simple-icons:freebsd" aria-hidden="true" />FreeBSD</p>
      <Cmd cmd={c.freebsd} copy={copy} />

      <p class="step-label"><Icon name="simple-icons:windows" aria-hidden="true" />Windows</p>
      {app.windows ? (
        <>
          <Cmd cmd={INSTALL_WIN} copy={copy} />
          <p class="muted note">{t(lang, "apps.ui.winCovers")}</p>
          {app.slug === "overdev" && (
            <>
              <p class="muted note">{t(lang, "apps.install.windows_git")}</p>
              <Cmd cmd={GIT_WIN} copy={copy} />
            </>
          )}
        </>
      ) : (
        <p class="muted note">{t(lang, "apps.ui.noWindows")}</p>
      )}

      <p class="step-label"><Icon name="simple-icons:apple" aria-hidden="true" />macOS</p>
      <p class="muted note">{t(lang, "apps.ui.macos")}</p>

      <p class="note">{t(lang, "apps.install.note")}</p>
      <div class="cta-row">
        <a class="btn btn-primary" href={REPO} target="_blank" rel="noopener noreferrer">{t(lang, "apps.ui.repo")}</a>
        {app.windows && <a class="btn btn-ghost" href={WIN_REPO} target="_blank" rel="noopener noreferrer">{t(lang, "apps.ui.repoWindows")}</a>}
        <a class="btn btn-ghost" href={RELEASES} target="_blank" rel="noopener noreferrer">{t(lang, "apps.platforms.releases")}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { padding-block: clamp(3rem, 8vw, 5.5rem); }
  .back { margin: 0 0 1.4rem; font-size: var(--step-1); }
  .back a { display: inline-flex; align-items: center; gap: 0.4rem; color: var(--muted); }
  .back :global([data-icon]) { width: 15px; height: 15px; }
  [dir="rtl"] .back :global([data-icon]) { transform: scaleX(-1); }
  h1 { display: flex; align-items: center; gap: 0.8rem; flex-wrap: wrap; }
  .ico { display: inline-flex; width: 48px; height: 48px; align-items: center; justify-content: center; border: 1px solid var(--line); border-radius: 14px; color: var(--accent-ink); }
  .ico :global([data-icon]) { width: 24px; height: 24px; }
  .feats { list-style: none; margin: 1.6rem 0 0; padding: 0; display: grid; gap: 0.9rem; max-width: 62ch; }
  .feats li { display: flex; gap: 0.7rem; align-items: flex-start; color: var(--ink-2); }
  .feats li :global([data-icon]) { flex: none; width: 18px; height: 18px; margin-top: 0.2em; color: var(--ok); }
  .step-label { display: flex; align-items: center; gap: 0.5rem; font-family: var(--font-mono); font-size: var(--step-1); color: var(--muted); margin: 1.6rem 0 0.5rem; }
  .step-label :global([data-icon]) { width: 16px; height: 16px; }
  .lead-note, .note { font-size: var(--step-1); max-width: 66ch; margin-top: 0.8rem; }
</style>
