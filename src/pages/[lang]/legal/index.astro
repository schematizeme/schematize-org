---
import Base from "../../../layouts/Base.astro";
import { LOCALES, t, tx, path, type Locale } from "../../../lib/i18n";
export function getStaticPaths() {
  return LOCALES.map((l) => ({ params: { lang: l } }));
}
const lang = Astro.params.lang as Locale;
const items = tx<{ h: string; p: string; slug: string }[]>(lang, "legal.index.items");
---
<Base
  locale={lang}
  slug="legal"
  crumb={t(lang, "nav.legal")}
  title={t(lang, "legal.meta.title")}
  description={t(lang, "legal.meta.desc")}
>
  <section class="hero">
    <div class="wrap wrap-tight">
      <p class="kicker">{t(lang, "legal.hero.kicker")}</p>
      <h1>{t(lang, "legal.hero.h1")}</h1>
      <p class="lede">{t(lang, "legal.hero.sub")}</p>
      <p class="disclaimer">{t(lang, "legal.disclaimer")}</p>
    </div>
  </section>

  <section class="surface hair">
    <div class="wrap">
      <h2>{t(lang, "legal.index.title")}</h2>
      <div class="grid cols-2" style="margin-top:1.8rem">
        {items.map((it) => (
          <a class="card" href={path(lang, it.slug)}>
            <h3>{it.h}</h3>
            <p class="muted">{it.p}</p>
          </a>
        ))}
      </div>
      <p class="muted eff">{t(lang, "legal.effective")} {t(lang, "legal.effectiveDate")}</p>
    </div>
  </section>
</Base>

<style>
  .hero { padding-block: clamp(2.5rem, 6vw, 4.5rem); }
  .disclaimer {
    margin-top: 1.4rem; padding: 0.9rem 1.1rem; border: 1px solid var(--line);
    border-left: 3px solid var(--accent); border-radius: var(--radius);
    background: var(--accent-wash); color: var(--ink-2); font-size: var(--step-1); max-width: 66ch;
  }
  .eff { margin-top: 1.6rem; font-size: var(--step-1); }
</style>
