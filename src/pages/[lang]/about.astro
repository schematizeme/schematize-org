---
import Base from "../../layouts/Base.astro";
import { LOCALES, t, path, type Locale } from "../../lib/i18n";
export function getStaticPaths() {
  return LOCALES.map((l) => ({ params: { lang: l } }));
}
const lang = Astro.params.lang as Locale;

// Tabela de dados institucionais/fiscais — rótulo localizado + valor da fonte única `company`.
const L = (k: string) => t(lang, `about.facts.labels.${k}`);
const C = (k: string) => t(lang, `company.${k}`);
const facts: { k: string; v: string }[] = [
  { k: L("legalName"), v: C("legalName") },
  { k: L("tradeName"), v: C("tradeName") },
  { k: L("cnpj"), v: C("cnpj") },
  { k: L("founded"), v: C("founded") },
  { k: L("status"), v: C("status") },
  { k: L("cnae"), v: C("cnae") },
  { k: L("location"), v: C("location") },
  { k: L("contact"), v: C("email") },
];

// AboutPage (Organization já é global via Base, referenciada por @id).
const aboutJsonld = [
  {
    "@context": "https://schema.org",
    "@type": "AboutPage",
    name: t(lang, "about.meta.title"),
    about: { "@id": "https://schematize.org/#org" },
  },
];
---
<Base
  locale={lang}
  slug="about"
  crumb={t(lang, "nav.about")}
  title={t(lang, "about.meta.title")}
  description={t(lang, "about.meta.desc")}
  jsonld={aboutJsonld}
>
  <section class="hero">
    <div class="wrap wrap-tight">
      <p class="kicker">{t(lang, "about.hero.kicker")}</p>
      <h1>{t(lang, "about.hero.h1")}</h1>
      <p class="lede">{t(lang, "about.hero.sub")}</p>
    </div>
  </section>

  <section class="surface hair">
    <div class="wrap wrap-tight">
      <h2>{t(lang, "about.who.title")}</h2>
      <p class="muted">{t(lang, "about.who.p1")}</p>
      <p class="muted">{t(lang, "about.who.p2")}</p>
    </div>
  </section>

  <section>
    <div class="wrap wrap-tight">
      <h2>{t(lang, "about.mission.title")}</h2>
      <p class="lede">{t(lang, "about.mission.p")}</p>
    </div>
  </section>

  <section class="surface hair">
    <div class="wrap wrap-tight">
      <h2>{t(lang, "about.facts.title")}</h2>
      <p class="muted">{t(lang, "about.facts.note")}</p>
      <dl class="facts">
        {facts.map((f) => (
          <div class="fact">
            <dt>{f.k}</dt>
            <dd>{f.v}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section>
    <div class="wrap band">
      <h2>{t(lang, "about.cta.title")}</h2>
      <p class="lede">{t(lang, "about.cta.p")}</p>
      <div class="cta-row">
        <a class="btn btn-primary" href={path(lang, "contact")}>{t(lang, "about.cta.button")}</a>
        <a class="btn btn-ghost" href="https://github.com/schematizeme">GitHub</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { padding-block: clamp(3rem, 8vw, 6rem); }
  .facts { margin-top: 1.6rem; display: grid; gap: 0; border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
  .fact { display: grid; grid-template-columns: minmax(10rem, 16rem) 1fr; gap: 1rem; padding: 0.9rem 1.2rem; border-top: 1px solid var(--line-2); }
  .fact:first-child { border-top: 0; }
  .fact dt { color: var(--muted); font-size: var(--step-1); margin: 0; }
  .fact dd { margin: 0; color: var(--ink-2); }
  @media (max-width: 560px) { .fact { grid-template-columns: 1fr; gap: 0.2rem; } }
  .band { text-align: center; max-width: 640px; margin-inline: auto; }
  .band .lede { margin-inline: auto; }
  .band .cta-row { justify-content: center; }
</style>
