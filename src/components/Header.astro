---
// Header (.org) — logo + navegação institucional + troca de idioma + link pro código.
import LangModal from "./LangModal.astro";
import { t, path, type Locale } from "../lib/i18n";
interface Props { locale: Locale; slug?: string; }
const { locale, slug = "" } = Astro.props;
// Nav interno (páginas .org) + ecossistema do produto (subdomínios externos).
const nav = [
  { key: "projects", label: t(locale, "nav.projects") },
  { key: "research", label: t(locale, "nav.research") },
  { key: "about", label: t(locale, "nav.about") },
];
const product = [
  { href: "https://skills.schematize.org", label: t(locale, "nav.skills") },
  { href: "https://learn.schematize.org", label: t(locale, "nav.academy") },
];
---
<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href={path(locale, "")}>schematize<span aria-hidden="true">.org</span></a>
    <nav class="nav" aria-label="Primary">
      {nav.map((n) => (
        <a href={path(locale, n.key)} aria-current={slug === n.key ? "page" : undefined}>{n.label}</a>
      ))}
      {product.map((n) => (
        <a href={n.href} target="_blank" rel="noopener noreferrer">{n.label}</a>
      ))}
    </nav>
    <div class="actions">
      <LangModal locale={locale} slug={slug} />
      <a class="btn btn-ghost login" href="https://auth.schematize.org" target="_blank" rel="noopener noreferrer">{t(locale, "nav.login")}</a>
      <a class="btn btn-primary cta" href="https://github.com/schematizeme">{t(locale, "nav.cta")}</a>
    </div>
  </div>
</header>
<style>
  .site-header {
    position: sticky; top: 0; z-index: 40; background: color-mix(in srgb, var(--bg) 78%, transparent);
    backdrop-filter: saturate(150%) blur(14px); -webkit-backdrop-filter: saturate(150%) blur(14px);
    border-bottom: 1px solid var(--line-2);
  }
  .bar { display: flex; align-items: center; gap: 1rem; min-height: 64px; }
  .brand { font-family: var(--font-disp); font-weight: 600; font-size: 1.14rem; color: var(--ink); letter-spacing: -0.03em; }
  .brand span { color: var(--faint); font-weight: 500; }
  .brand:hover { text-decoration: none; }
  .nav { display: flex; gap: 1.6rem; margin-inline: auto; }
  .nav a { color: var(--muted); font-size: var(--step0); font-weight: 450; letter-spacing: -0.01em; }
  .nav a:hover, .nav a[aria-current="page"] { color: var(--ink); text-decoration: none; }
  .actions { display: flex; align-items: center; gap: 0.7rem; }
  .cta { padding: 0.52rem 1.05rem; font-size: var(--step-1); }
  .login { padding: 0.52rem 1.05rem; font-size: var(--step-1); }
  @media (max-width: 860px) {
    .login { display: none; }
  }
  @media (max-width: 720px) {
    .nav { display: none; }
    .cta { display: none; }
  }
</style>
