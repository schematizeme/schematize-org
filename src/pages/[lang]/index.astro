---
import Base from "../../layouts/Base.astro";
import { LOCALES, t, tx, path, type Locale } from "../../lib/i18n";

export function getStaticPaths() {
  return LOCALES.map((l) => ({ params: { lang: l } }));
}
const lang = Astro.params.lang as Locale;
const pillars = tx<{ h: string; p: string; key: string }[]>(lang, "home.pillars.items");
const why = tx<{ h: string; p: string }[]>(lang, "home.why.items");
---
<Base
  locale={lang}
  slug=""
  title={t(lang, "home.meta.title")}
  description={t(lang, "home.meta.desc")}
>
  <section class="hero">
    <div class="wrap">
      <p class="kicker">{t(lang, "home.hero.kicker")}</p>
      <h1>{t(lang, "home.hero.h1")}</h1>
      <p class="lede">{t(lang, "home.hero.sub")}</p>
      <div class="cta-row">
        <a class="btn btn-primary" href={path(lang, "projects")}>{t(lang, "home.hero.cta1")}</a>
        <a class="btn btn-ghost" href={path(lang, "research")}>{t(lang, "home.hero.cta2")}</a>
      </div>
    </div>
  </section>

  <section class="surface">
    <div class="wrap">
      <p class="kicker">{t(lang, "home.mission.kicker")}</p>
      <h2>{t(lang, "home.mission.title")}</h2>
      <p class="lede">{t(lang, "home.mission.p")}</p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <h2>{t(lang, "home.pillars.title")}</h2>
      <div class="grid cols-2" style="margin-top:1.8rem">
        {pillars.map((c) => (
          <a class="card pillar" href={path(lang, c.key)}>
            <h3>{c.h}</h3>
            <p class="muted">{c.p}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="surface">
    <div class="wrap">
      <h2>{t(lang, "home.why.title")}</h2>
      <div class="grid cols-3" style="margin-top:1.8rem">
        {why.map((w) => (<div class="card"><h3>{w.h}</h3><p class="muted">{w.p}</p></div>))}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap band">
      <h2>{t(lang, "home.cta.title")}</h2>
      <p class="lede">{t(lang, "home.cta.p")}</p>
      <div class="cta-row">
        <a class="btn btn-primary" href="https://github.com/schematizeme">GitHub</a>
        <a class="btn btn-ghost" href={path(lang, "research")}>{t(lang, "nav.research")}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { padding-block: clamp(3.5rem, 9vw, 7rem); }
  .hero h1 { max-width: 18ch; }
  .pillar { display: block; transition: 0.15s; }
  .pillar:hover { border-color: var(--accent); text-decoration: none; transform: translateY(-2px); }
  .band { text-align: center; }
  .band .lede { margin-inline: auto; }
  .band .cta-row { justify-content: center; }
</style>
