---
import Base from "../../layouts/Base.astro";
import { LOCALES, t, tx, path, type Locale } from "../../lib/i18n";

export function getStaticPaths() {
  return LOCALES.map((l) => ({ params: { lang: l } }));
}
const lang = Astro.params.lang as Locale;
const items = tx<{ h: string; p: string; href: string; tag: string }[]>(lang, "projects.list.items");
---
<Base
  locale={lang}
  slug="projects"
  title={t(lang, "projects.meta.title")}
  description={t(lang, "projects.meta.desc")}
>
  <section class="hero">
    <div class="wrap">
      <p class="kicker">{t(lang, "projects.hero.kicker")}</p>
      <h1>{t(lang, "projects.hero.h1")}</h1>
      <p class="lede">{t(lang, "projects.hero.sub")}</p>
    </div>
  </section>

  <section class="surface">
    <div class="wrap">
      <h2>{t(lang, "projects.list.title")}</h2>
      <div class="grid cols-2" style="margin-top:1.8rem">
        {items.map((p) => (
          <a class="card proj" href={p.href}>
            <span class="tag">{p.tag}</span>
            <h3>{p.h}</h3>
            <p class="muted">{p.p}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap band">
      <h2>{t(lang, "projects.cta.title")}</h2>
      <p class="lede">{t(lang, "projects.cta.p")}</p>
      <div class="cta-row">
        <a class="btn btn-primary" href="https://github.com/schematizeme">GitHub</a>
        <a class="btn btn-ghost" href={path(lang, "research")}>{t(lang, "nav.research")}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { padding-block: clamp(3rem, 8vw, 6rem); }
  .proj { display: block; transition: 0.15s; }
  .proj:hover { border-color: var(--accent); text-decoration: none; transform: translateY(-2px); }
  .proj .tag { margin-bottom: 0.7rem; display: inline-block; }
  .band { text-align: center; }
  .band .lede { margin-inline: auto; }
  .band .cta-row { justify-content: center; }
</style>
