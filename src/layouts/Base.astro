---
// Base.astro — shell de SEO + design da casa para schematize.org.
// O quê: <head> completo (title/description, self-canonical, hreflang recíproco dos 6
// locales + x-default, OG/Twitter, JSON-LD Organization+WebSite com sameAs cross-domain)
// e o design system (tokens, dark/light, sem emoji). Onde: envolve todas as páginas.
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { alternates, LOCALE_META, DEFAULT_LOCALE, type Locale } from "../lib/i18n";

interface Props {
  locale: Locale;
  slug?: string;
  title: string;
  description: string;
  jsonld?: unknown[];
}
const { locale, slug = "", title, description, jsonld = [] } = Astro.props;
const site = Astro.site ?? new URL("https://schematize.org");
const canonical = new URL(`/${locale}/${slug ? slug + "/" : ""}`, site).href;
const alts = alternates(slug);
const ogLocale = LOCALE_META[locale].bcp47.replace("-", "_");

const org = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "schematize",
  url: "https://schematize.org",
  description:
    "schematize.org is the open-source and technology-research lab behind schematize — building tools in the open and sharing what we learn.",
  sameAs: [
    "https://schematize.net",
    "https://schematize.me",
    "https://schematize.com.br",
    "https://github.com/schematizeme",
    "https://blog.schematize.net",
  ],
};
const website = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "schematize.org",
  url: "https://schematize.org",
  inLanguage: Object.values(LOCALE_META).map((m) => m.bcp47),
};
const graphs = [org, website, ...jsonld];
---

<!doctype html>
<html lang={LOCALE_META[locale].bcp47}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alts.map((a) => (
      <link rel="alternate" hreflang={a.bcp47} href={new URL(a.href, site).href} />
    ))}
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(`/${DEFAULT_LOCALE}/${slug ? slug + "/" : ""}`, site).href}
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="schematize" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    {graphs.map((g) => (
      <script type="application/ld+json" set:html={JSON.stringify(g)} />
    ))}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header locale={locale} slug={slug} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />

    <style is:global>
      :root {
        --bg: #ffffff;
        --surface: #f6f7f9;
        --card: #ffffff;
        --ink: #0e1116;
        --muted: #5b6572;
        --line: #e6e8ec;
        --accent: #0e8f7e;
        --accent-ink: #0b6f62;
        --ok: #1f7d5c;
        --radius: 14px;
        --maxw: 1120px;
        --step-1: clamp(0.82rem, 0.79rem + 0.15vw, 0.9rem);
        --step0: clamp(1rem, 0.96rem + 0.2vw, 1.08rem);
        --step1: clamp(1.2rem, 1.1rem + 0.5vw, 1.4rem);
        --step2: clamp(1.55rem, 1.35rem + 1vw, 2.05rem);
        --step3: clamp(2.05rem, 1.6rem + 2.2vw, 3.15rem);
        --step4: clamp(2.6rem, 1.9rem + 3.4vw, 4.2rem);
        --font-sans: "Inter", system-ui, -apple-system, Segoe UI, Roboto, sans-serif;
        --font-disp: "Space Grotesk", var(--font-sans);
        --font-mono: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #0c0e12;
          --surface: #12151b;
          --card: #14181f;
          --ink: #eef1f5;
          --muted: #9aa4b2;
          --line: #232833;
          --accent: #4fd6bf;
          --accent-ink: #7fe3d2;
        }
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font-family: var(--font-sans);
        font-size: var(--step0);
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }
      .skip {
        position: absolute; left: -999px; top: 0; background: var(--ink); color: var(--bg);
        padding: 0.6rem 1rem; z-index: 100; border-radius: 0 0 8px 0;
      }
      .skip:focus { left: 0; }
      a { color: var(--accent-ink); text-decoration: none; }
      a:hover { text-decoration: underline; }
      h1, h2, h3 { font-family: var(--font-disp); line-height: 1.12; letter-spacing: -0.02em; margin: 0 0 0.5em; }
      h1 { font-size: var(--step4); font-weight: 700; }
      h2 { font-size: var(--step3); font-weight: 700; }
      h3 { font-size: var(--step1); font-weight: 600; letter-spacing: -0.01em; }
      p { margin: 0 0 1rem; max-width: 68ch; }
      main { display: block; }
      code, kbd { font-family: var(--font-mono); font-size: 0.9em; }
      .wrap { width: 100%; max-width: var(--maxw); margin-inline: auto; padding-inline: clamp(1.1rem, 4vw, 2rem); }
      section { padding-block: clamp(3rem, 7vw, 6rem); }
      .kicker {
        font-family: var(--font-mono); font-size: var(--step-1); letter-spacing: 0.08em;
        text-transform: uppercase; color: var(--accent-ink); margin: 0 0 1rem;
      }
      .lede { font-size: var(--step1); color: var(--muted); max-width: 60ch; }
      .btn {
        display: inline-flex; align-items: center; gap: 0.5rem; font-weight: 600;
        padding: 0.72rem 1.15rem; border-radius: 10px; border: 1px solid transparent;
        font-family: var(--font-sans); font-size: var(--step0); cursor: pointer; transition: 0.15s;
      }
      .btn-primary { background: var(--accent); color: #fff; }
      .btn-primary:hover { background: var(--accent-ink); text-decoration: none; }
      .btn-ghost { border-color: var(--line); color: var(--ink); background: transparent; }
      .btn-ghost:hover { border-color: var(--accent); text-decoration: none; }
      .grid { display: grid; gap: clamp(1rem, 2.5vw, 1.6rem); }
      .cols-2 { grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr)); }
      .cols-3 { grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr)); }
      .card {
        background: var(--card); border: 1px solid var(--line); border-radius: var(--radius);
        padding: clamp(1.2rem, 2.5vw, 1.7rem);
      }
      .card h3 { margin-top: 0; }
      .muted { color: var(--muted); }
      .surface { background: var(--surface); }
      .eyebrow-row { display: flex; flex-wrap: wrap; gap: 0.5rem; }
      .tag {
        font-family: var(--font-mono); font-size: var(--step-1); color: var(--muted);
        border: 1px solid var(--line); border-radius: 999px; padding: 0.2rem 0.7rem;
      }
      pre {
        background: var(--ink); color: #f4f6fb; border-radius: 12px; padding: 1rem 1.15rem;
        overflow-x: auto; font-family: var(--font-mono); font-size: 0.9rem; line-height: 1.7;
      }
      @media (prefers-color-scheme: dark) { pre { background: #05070a; border: 1px solid var(--line); } }
      .cta-row { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 1.6rem; }
      hr { border: 0; border-top: 1px solid var(--line); margin: 0; }
      @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } * { transition: none !important; } }
    </style>
  </body>
</html>
