---
// /software foi substituída por /apps. Página de redirecionamento: meta refresh 0 +
// link visível + noindex, canonical para a nova URL. HTML autônomo (sem Base).
import { LOCALES, t, path, type Locale } from "../../lib/i18n";
export function getStaticPaths() {
  return LOCALES.map((l) => ({ params: { lang: l } }));
}
const lang = Astro.params.lang as Locale;
const target = path(lang, "apps");
const abs = new URL(target, "https://schematize.org").href;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t(lang, "nav.apps")} — schematize.org</title>
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href={abs} />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
  </head>
  <body>
    <p><a href={target}>{t(lang, "nav.apps")}</a></p>
  </body>
</html>
